# Bắt buộc thay khi triển khai thật
JWT_SECRET=change-this-to-a-long-random-secret
NEXTAUTH_SECRET=change-this-to-another-long-random-secret
NEXTAUTH_URL=http://localhost:3100
POSTGRES_PASSWORD=cvonline

# Cổng public (3100 được chọn vì máy phát triển hiện đang dùng cổng 3000)
FRONTEND_PORT=3100
BACKEND_PORT=9999
NEXT_PUBLIC_API_URL=http://localhost:9999/api
DATABASE_SSL=false

# Đăng nhập Google (không bắt buộc nếu không dùng Google OAuth)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Các tích hợp tùy chọn
